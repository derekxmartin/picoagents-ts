{
  "name": "picoagents",
  "version": "0.4.0",
  "description": "TypeScript port of the picoagents multi-agent framework",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
